# Copy this to .env and fill in values. NEVER commit .env to git.
PORT=3000
FIREBASE_PROJECT_ID=workgo-sih2026
# Paste the entire service account JSON as a single-line string, or point to the file path
FIREBASE_SERVICE_ACCOUNT_JSON=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Document encryption key (32-byte hex string)
DOCUMENT_ENCRYPTION_KEY=

# Render backend URL (used for self-ping to prevent cold starts)
SELF_PING_URL=https://workgo-api.onrender.com/api/health

# Gemini 1.5 Flash — AI Triage Proxy (Tier 3 cloud inference)
# Keep this server-side ONLY. NEVER commit to git or embed in APK.
GEMINI_API_KEY=

# Bhashini (MeitY / Digital India) — Optional Vernacular ASR & NMT
# Obtain credentials from https://bhashini.gov.in / ULCA portal
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543d6

# ── Dial Karya — Voice IVR (Asterisk AMI) ──────────────────────────────────────
# Asterisk Manager Interface credentials (set in /etc/asterisk/manager.conf on WSL2)
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=workgo_node
ASTERISK_AMI_SECRET=nodeSecret123

# Sounds directory where Bhashini TTS audio files are stored for Asterisk Playback()
# WSL2: /var/lib/asterisk/sounds/workgo
ASTERISK_SOUNDS_DIR=/var/lib/asterisk/sounds/workgo

# Optional shared secret to validate Asterisk curl webhook calls (recommended in production)
ASTERISK_WEBHOOK_SECRET=

# Gateway SIM number for outbound robocalls and Caller ID
DIAL_KARYA_GATEWAY_NUMBER=+919080262334
ASTERISK_GATEWAY_NUMBER=+919080262334
