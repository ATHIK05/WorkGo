# Copy this to .env and fill in values. NEVER commit .env to git.
PORT=3000
FIREBASE_PROJECT_ID=workgo-sih2026
# Paste the entire service account JSON as a single-line string, or point to the file path
FIREBASE_SERVICE_ACCOUNT_JSON=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Document encryption key (32-byte hex string)
DOCUMENT_ENCRYPTION_KEY=

# Render backend URL (used for self-ping to prevent cold starts)
SELF_PING_URL=https://workgo-api.onrender.com/api/health

# Gemini 1.5 Flash — AI Triage Proxy (Tier 3 cloud inference)
# Keep this server-side ONLY. NEVER commit to git or embed in APK.
GEMINI_API_KEY=

